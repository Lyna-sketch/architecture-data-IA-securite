# Copier ce fichier en `.env` puis remplir les valeurs :  cp .env.example .env
# Le fichier .env est ignoré par Git : les secrets n'arrivent jamais dans le dépôt.

# --- Accès au bucket S3 des factures (clés fournies via la console Hyperfluid) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=https://dams-5.s3-gateway.console.hyperfluid.cloud
AWS_DEFAULT_REGION=default
S3_BUCKET=factures
# Préfixe optionnel (sous-dossier dans le bucket) ; vide = tout le bucket
S3_PREFIX=

# --- Dossier local des données ---
DATA_DIR=data
