# Copier ce fichier en `.env` puis remplir les valeurs :  cp .env.example .env
# Le fichier .env est ignoré par Git : les secrets n'arrivent jamais dans le dépôt.

# --- Bucket S3 des factures (clés créées dans la console Hyperfluid) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=https://dams-5.s3-gateway.console.hyperfluid.cloud
AWS_DEFAULT_REGION=default
S3_BUCKET=factures

# --- Modèle d'OCR LightOnOCR-3 (clé créée dans la console Hyperfluid) ---
# Adresse et nom du modèle : indiqués sur la page du modèle dans Hyperfluid
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=
OCR_DPI=130
