# Copier ce fichier en `.env` puis remplir les valeurs :  cp .env.example .env
# Le fichier .env est ignoré par Git : les secrets n'arrivent jamais dans le dépôt.

# --- Bucket S3 des factures (clés créées dans la console Hyperfluid) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=https://dams-5.s3-gateway.console.hyperfluid.cloud
AWS_DEFAULT_REGION=default
S3_BUCKET=factures

# --- Modèle d'OCR LightOnOCR-3 (clé créée dans la console Hyperfluid) ---
# Adresse et nom du modèle : indiqués sur la page du modèle dans Hyperfluid
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=
OCR_DPI=130

# --- LLM de l'agent (étape 8) : un « profil » par LLM, choisi avec --llm <profil> ---
# Chaque profil P se décrit par P_BASE_URL, P_API_KEY et P_MODEL (API compatible OpenAI).
LLM_PROFIL=gemma

# LLM hébergé : Gemma sur Hyperfluid (clé créée dans la console Hyperfluid)
GEMMA_BASE_URL=https://llm.hyperfluid.cloud/v1/organizations/<organisation>/shared-models/gemma-4-12b/v1
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-12b

# LLM local avec Ollama (https://ollama.com) :  ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b
